{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ikiz",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "sahte-ikas",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/mock-ikas.mjs"
      ],
      "port": 4010
    },
    {
      "name": "test",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DATABASE_URL=file:./test.db",
        "APP_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        "CRON_SECRET=test",
        "APP_URL=http://localhost:3100",
        "NEXT_DIST_DIR=.next-test",
        "IKAS_GRAPHQL_URL=http://localhost:4010/graphql",
        "IKAS_TOKEN_URL=http://localhost:4010/{store}/token",
        "IKAS_IMAGE_URL=http://localhost:4010/image",
        "META_APP_ID=test-app",
        "META_APP_SECRET=test-secret",
        "META_DIALOG_URL=http://localhost:4030/dialog/oauth",
        "META_GRAPH_URL=http://localhost:4030",
        "GOOGLE_CLIENT_ID=test-client",
        "GOOGLE_CLIENT_SECRET=test-secret",
        "GOOGLE_AUTH_URL=http://localhost:4040/auth",
        "GOOGLE_TOKEN_URL=http://localhost:4040/token",
        "GOOGLE_REVOKE_URL=http://localhost:4040/revoke",
        "GOOGLE_ADS_URL=http://localhost:4040/ads",
        "GA4_DATA_URL=http://localhost:4040/ga4data",
        "GA4_ADMIN_URL=http://localhost:4040/ga4admin",
        "npx",
        "next",
        "dev",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "mobil",
      "runtimeExecutable": "mobile/node_modules/.bin/expo",
      "runtimeArgs": [
        "start",
        "mobile",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "sahte-meta",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/mock-meta.mjs"
      ],
      "port": 4030
    },
    {
      "name": "sahte-google",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/mock-google.mjs"
      ],
      "port": 4040
    }
  ]
}
