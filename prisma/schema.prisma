// Not: Yerelde SQLite. Yayına alırken provider "postgresql" yapılıp DATABASE_URL değiştirilir.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Yönetim paneli (backofis) hesabı — müşteri hesaplarından tamamen ayrıdır.
model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// Platform kullanıcısı (kiracı). Her kullanıcının kendi mağazaları ve verisi vardır.
model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  lastSyncAt   DateTime?
  // Paket (ödeme entegrasyonu yok; backofisten yönetilir)
  plan          String    @default("baslangic") // baslangic | profesyonel | kurumsal
  billingPeriod String    @default("aylik") // aylik | yillik
  trialEndsAt   DateTime?
  paidUntil     DateTime?
  suspended     Boolean   @default(false)
  billing       BillingInfo?
  payments      Payment[]
  // Stok ayarları
  safetyStock       Float  @default(0) // mağazalara yazılmayan tampon adet
  lowStockThreshold Float? // null = uyarı kapalı
  // Akıllı dağıtım: satılabilir stok bu değere ve altına inince yalnızca öncelikli mağazada satışa açılır.
  criticalStock     Float? // null = kapalı
  priorityStoreId   String? // kritik stokta satışa açık kalan mağaza
  notifications     Notification[]
  automationRules   AutomationRule[]
  websites          Website[]
  adIntegrations    AdIntegration[]
  skuSettings    SkuSetting[]
  definitions    Definition[]
  stockMovements StockMovement[]
  stores       Store[]
  sharedItems  SharedItem[]
  syncLogs     SyncLog[]
}

model Store {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  label           String // panelde görünen ad
  platform        String         @default("ikas") // yalnızca "ikas" desteklenir
  storeName       String // <storeName>.myikas.com
  externalId      String? // kullanılmıyor (eski kayıtlarla uyum için tutuluyor)
  clientId        String
  clientSecretEnc String // AES-256-GCM ile şifreli
  accessToken     String?
  tokenExpiresAt  DateTime?
  stockLocationId String?
  webhookSecret   String
  webhooksActive  Boolean        @default(false)
  lastOrderSyncAt DateTime?
  lastCartSyncAt  DateTime?
  lastSyncAt      DateTime?
  lastError       String?
  merchantId      String? // görsel adresleri için
  // Otomatik fiyat kuralı: bu mağazanın fiyatı = diğer mağazanın fiyatı × (1 + yüzde/100) + sabit
  priceRuleActive Boolean        @default(false)
  pricePercent    Float          @default(0)
  priceFixed      Float          @default(0)
  priceRound      String         @default("none") // none | 1 | 0.90 | 0.99
  stockSharePercent Float        @default(100) // ortak stoğun bu mağazada görünen payı
  minStock        Float          @default(0) // stok varsa bu mağazaya en az bu kadar yazılır (kritik mod hariç)
  createdAt       DateTime       @default(now())
  variants        StoreVariant[]
  aliases         SkuAlias[]
  orders          Order[]
  website         Website?
  carts           AbandonedCart[]
  sfKey           String?        @unique // vitrin betiğinin herkese açık anahtarı (gizli değildir, yenilenebilir)
  sfModules       StoreModule[]
  sfStats         ModuleStat[]
  wheelEntries    WheelEntry[]
  productMetas    ProductMeta[]

  @@unique([userId, storeName])
}

// SKU başına ortak (paylaşılan) stok — tek doğru kaynak.
model SharedItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sku         String
  name        String
  sharedStock Float
  // Panelden yapılan, bir sonraki senkronda uygulanacak düzeltme
  pendingDelta Float   @default(0)
  pendingNote  String?
  updatedAt   DateTime @updatedAt

  @@unique([userId, sku])
}

// Fatura bilgileri (hesap başına bir kayıt)
model BillingInfo {
  id        String @id @default(cuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String @default("kurumsal") // bireysel | kurumsal
  name      String // ad soyad veya şirket unvanı
  taxNumber String // TCKN veya VKN
  taxOffice String @default("")
  address   String
  district  String
  city      String
  phone     String
  email     String
}

// Lisans siparişi / ödeme kaydı
model Payment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reference   String    @unique // havale açıklamasına yazılan kod
  plan        String
  period      String // aylik | yillik
  amount      Float // KDV hariç
  vat         Float
  total       Float
  method      String    @default("havale") // havale | kart
  status      String    @default("bekliyor") // bekliyor | bildirildi | odendi | iptal
  billingJson String // sipariş anındaki fatura bilgileri
  createdAt   DateTime  @default(now())
  paidAt      DateTime?
  periodEnd   DateTime?

  @@index([userId, createdAt])
  @@index([status])
}

// SKU'ya özel ayarlar
model SkuSetting {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sku               String
  excluded          Boolean @default(false) // ortak stok senkronu dışında
  safetyStock       Float? // null = genel ayar
  lowStockThreshold Float? // null = genel ayar
  // Tanımlamalar (Definition) içinden atananlar; ad olarak saklanır.
  category          String?
  brand             String?
  fields            String  @default("{}") // özel alan değerleri: { "alan adı": "değer" }

  @@unique([userId, sku])
  @@index([userId, category])
  @@index([userId, brand])
}

// Tanımlamalar: kullanıcının kendi kategori, marka ve özel alan adları (platformdan bağımsız).
model Definition {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // category | brand | field
  name      String
  createdAt DateTime @default(now())

  @@unique([userId, kind, name])
}

// Ortak stok hareketleri
model StockMovement {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sku         String
  createdAt   DateTime @default(now())
  storeLabel  String?
  delta       Float
  sharedAfter Float
  reason      String // sale | increase | panel | link
  note        String?

  @@index([userId, sku, createdAt])
}

// Bir mağazadaki varyant ve o mağazada en son gördüğümüz/yazdığımız stok.
model StoreVariant {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sku           String
  productId     String
  variantId     String
  productName   String
  currentStock  Float    @default(0)
  sellPrice     Float?
  discountPrice Float?
  buyPrice      Float?
  imageId       String?
  barcode       String?
  // Mağazalar arası eşleşme anahtarı: normalde SKU, elle eşleştirme varsa karşı mağazanın SKU'su
  matchSku      String   @default("")
  lastSeenStock Float? // null = henüz ortak stoğa bağlanmadı
  duplicateSku  Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  @@unique([storeId, variantId])
  @@index([storeId, sku])
  @@index([storeId, matchSku])
}

// Elle SKU eşleştirme: bu mağazadaki "sku", ortak stokta "matchSku" olarak sayılır.
model SkuAlias {
  id       String @id @default(cuid())
  storeId  String
  store    Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sku      String
  matchSku String

  @@unique([storeId, sku])
}

// Sipariş — müşteri adı, e-posta, telefon, adres gibi alanlar BİLEREK yok.
model Order {
  id              String      @id @default(cuid())
  storeId         String
  store           Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ikasOrderId     String
  orderNumber     String
  status          String
  paymentStatus   String?
  packageStatus   String?
  currency        String
  totalFinalPrice Float
  orderedAt       DateTime?
  shippingMethod  String?
  // Kargo paketleri (JSON): [{ number, barcode, cargoCompany, trackingNumber, trackingLink }]
  packages        String      @default("[]")
  // Rapor alanları (kişisel veri içermez: yalnızca kanal, kaynak, il/ilçe, kampanya)
  salesChannel    String?
  trafficSource   String?
  referer         String? // yalnızca alan adı
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  city            String?
  district        String?
  couponCode      String?
  campaigns       String      @default("[]") // [{ name, type, amount }]
  tags            String      @default("[]") // otomasyonun eklediği etiketler
  // Panelden silindi (ikas'ta durur). Senkron tekrar getirse de gizli kalır.
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  lines           OrderLine[]

  @@unique([storeId, ikasOrderId])
  @@index([storeId, orderedAt])
}

model OrderLine {
  id         String @id @default(cuid())
  orderId    String
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku        String
  name       String
  quantity   Float
  finalPrice Float?
  imageId    String?
  ikasLineId String?
  status     String?
}

// Terk edilmiş sepet — müşteri adı, e-posta, telefon alınmaz.
model AbandonedCart {
  id             String    @id @default(cuid())
  storeId        String
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ikasId         String
  status         String // OPEN | COMPLETED | FREEZE | KILLED
  recoveryStatus String? // NOT_RECOVERED | RECOVERED
  emailStatus    String? // NOT_SENT | SENT
  total          Float
  currency       String    @default("TRY")
  itemCount      Float     @default(0)
  couponCode     String?
  city           String?
  lastActivityAt DateTime?
  linesJson      String    @default("[]") // [{ name, sku, imageId, quantity, price }]
  seenAt         DateTime  @default(now())

  @@unique([storeId, ikasId])
  @@index([storeId, lastActivityAt])
}

model SyncLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  level     String   @default("info") // info | warn | error
  sku       String?
  storeLabel String?
  message   String

  @@index([userId, createdAt])
}

// Panel bildirimleri (kritik stok, otomasyon). Okununca readAt dolar.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // stock | automation
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

// Sipariş otomasyonu: koşullar (VE) sağlanınca aksiyonlar çalışır.
model AutomationRule {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  active     Boolean         @default(true)
  conditions String          @default("[]") // [{ field, op, value }]
  actions    String          @default("[]") // [{ type, value }]
  runCount   Int             @default(0)
  lastRunAt  DateTime?
  createdAt  DateTime        @default(now())
  runs       AutomationRun[]

  @@index([userId, active])
}

// Bir kural bir siparişte yalnızca bir kez çalışır (tekrarlı webhook/senkron güvenliği).
model AutomationRun {
  id        String         @id @default(cuid())
  ruleId    String
  rule      AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  orderId   String
  createdAt DateTime       @default(now())

  @@unique([ruleId, orderId])
}

// ───────────── Reklam analizi ─────────────
// Kullanıcının web sitesi. Bir siteye en fazla bir ikas mağazası bağlanır; bir mağaza tek siteye aittir.
model Website {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  domain     String // küçük harf, protokolsüz, www'suz (ör. magazam.com)
  storeId    String?            @unique
  store      Store?             @relation(fields: [storeId], references: [id], onDelete: SetNull)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  adAccounts WebsiteAdAccount[]
  analytics  AnalyticsProperty?

  @@unique([userId, domain])
}

// Bir reklam platformu bağlantısı (OAuth). Token'lar AES-256-GCM ile şifreli saklanır.
model AdIntegration {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String // meta | google | ga4
  externalUserId  String // platformdaki kullanıcı/yetkilendiren kimliği
  displayName     String?
  accessTokenEnc  String
  refreshTokenEnc String?
  tokenExpiresAt  DateTime?
  scopes          String      @default("")
  status          String      @default("active") // active | expired | revoked | error
  lastError       String?
  lastSyncAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  accounts        AdAccount[]
  properties      AnalyticsProperty[]

  @@unique([userId, provider, externalUserId])
}

// Bağlantı üzerinden erişilen reklam hesabı (Meta act_..., Google müşteri kimliği).
model AdAccount {
  id            String             @id @default(cuid())
  integrationId String
  integration   AdIntegration      @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  provider      String // meta | google (sorgu kolaylığı için tekrarlanır)
  externalId    String
  name          String
  currency      String?
  timezone      String?
  managerId     String? // Google MCC altındaysa yönetici hesap kimliği
  remoteStatus  Int? // platformdaki hesap durumu (Meta account_status)
  metricsSyncedAt DateTime? // reklam verisinin son çekildiği an (gereksiz API çağrısını önlemek için)
  metricsError  String?
  campaigns     AdCampaign[]
  metrics       AdDailyMetric[]
  selected      Boolean            @default(false) // kullanıcı raporlamaya dahil etti mi
  createdAt     DateTime           @default(now())
  websites      WebsiteAdAccount[]

  @@unique([integrationId, externalId])
}

// Site ↔ reklam hesabı (çoka çok). İkisi de aynı kullanıcıya ait olmalı; uygulama katmanında denetlenir.
model WebsiteAdAccount {
  websiteId   String
  website     Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  adAccountId String
  adAccount   AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([websiteId, adAccountId])
}

// Reklam kampanyası (Meta campaign / Google campaign).
model AdCampaign {
  id          String          @id @default(cuid())
  adAccountId String
  adAccount   AdAccount       @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  externalId  String
  name        String
  status      String? // Meta effective_status
  objective   String?
  updatedAt   DateTime        @updatedAt
  metrics     AdDailyMetric[]

  @@unique([adAccountId, externalId])
}

// Kampanya başına günlük ham metrikler. Oranlar (CPC, CPM, CTR, ROAS) saklanmaz; toplamlardan hesaplanır.
// Tarih, reklam hesabının saat dilimindeki gündür (Meta verisi hesabın saat diliminde raporlanır).
model AdDailyMetric {
  id            String     @id @default(cuid())
  adAccountId   String
  adAccount     AdAccount  @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  campaignId    String
  campaign      AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  date          String // YYYY-MM-DD
  currency      String?
  spend         Float      @default(0)
  impressions   Int        @default(0)
  reach         Int        @default(0) // günlük erişim; günler arasında toplanamaz
  clicks        Int        @default(0)
  purchases     Float      @default(0) // platformun raporladığı satın alma
  purchaseValue Float      @default(0) // platformun raporladığı dönüşüm değeri
  updatedAt     DateTime   @updatedAt

  @@unique([campaignId, date])
  @@index([adAccountId, date])
}

// Google Analytics 4 mülkü. Bir siteye en fazla bir mülk bağlanır.
model AnalyticsProperty {
  id              String           @id @default(cuid())
  integrationId   String
  integration     AdIntegration    @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  propertyId      String // yalnızca rakam (properties/123 → 123)
  name            String
  accountName     String?
  currency        String?
  timezone        String?
  websiteId       String?          @unique
  website         Website?         @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  metricsSyncedAt DateTime?
  metricsError    String?
  createdAt       DateTime         @default(now())
  daily           AnalyticsDaily[]

  @@unique([integrationId, propertyId])
}

// GA4 günlük metrikleri, varsayılan kanal grubuna göre. Kullanıcı sayısı günler ve kanallar arasında toplanamaz.
model AnalyticsDaily {
  id         String            @id @default(cuid())
  propertyId String
  property   AnalyticsProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  date       String // YYYY-MM-DD, mülkün saat diliminde
  channel    String // sessionDefaultChannelGroup
  sessions   Int               @default(0)
  users      Int               @default(0)
  keyEvents  Float             @default(0)
  purchases  Float             @default(0) // ecommercePurchases
  revenue    Float             @default(0) // purchaseRevenue
  updatedAt  DateTime          @updatedAt

  @@unique([propertyId, date, channel])
}

// Vitrin modülü: ikas mağazasının canlı temasında çalışan bir modülün mağazaya özel ayarı.
model StoreModule {
  id          String    @id @default(cuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  moduleKey   String // src/lib/storefront/modules.ts içindeki anahtar
  enabled     Boolean   @default(false)
  settings    String    @default("{}") // yayındaki ayarlar (JSON)
  draft       String? // yayınlanmamış taslak (JSON); yalnızca önizlemede görünür
  version     Int       @default(0)
  publishedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([storeId, moduleKey])
}

// Vitrin modülü olayları, gün bazında toplanır (ziyaretçi kimliği saklanmaz).
model ModuleStat {
  id        String @id @default(cuid())
  storeId   String
  store     Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  moduleKey String
  day       String // YYYY-MM-DD (UTC)
  type      String // view | click | use | convert
  count     Int    @default(0)
  value     Float  @default(0) // dönüşüm tutarı toplamı
  @@unique([storeId, moduleKey, day, type])
}

// Hediye Çarkı katılımı. KVKK: iletişim bilgisi ve IP düz metin saklanmaz; tekrar kontrolü için anahtarlı özet (HMAC) tutulur.
// İletişim bilgisi yalnızca mağaza "sakla" seçeneğini açtıysa ve ziyaretçi açık rıza verdiyse şifreli (AES-256-GCM) saklanır.
model WheelEntry {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  contactHash String? // e-posta/telefon HMAC
  contactEnc  String? // yalnızca rıza ile, şifreli
  consent     Boolean  @default(false)
  ipHash      String
  cookieId    String
  prizeKey    String // dilim kimliği (ayar içindeki sıra değil, kalıcı anahtar)
  prizeLabel  String
  prizeType   String // RATIO | FIXED_AMOUNT | FREE_SHIPPING | CODE | NONE
  code        String?  @unique // kişiye özel ikas kuponu
  campaignId  String? // ikas kampanya kimliği
  createdAt   DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([storeId, contactHash])
  @@index([storeId, ipHash])
  @@index([storeId, cookieId])
}

// Vitrin modülleri için ikas ürün bilgisi (Admin API listProduct): vitrin bağlantısı, kategoriler ve eklenme tarihi.
// Ortak stok senkronundan bağımsızdır; modüller yayınlanınca ve en fazla 6 saatte bir yenilenir.
model ProductMeta {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId   String
  name        String
  slug        String
  categoryIds String   @default("[]") // JSON
  createdAt   DateTime? // ikas ürün oluşturma zamanı
  syncedAt    DateTime @default(now())

  @@unique([storeId, productId])
  @@index([storeId, slug])
}
