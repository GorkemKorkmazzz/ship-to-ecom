// Not: Yerelde SQLite. Yayında DATABASE_URL postgres:// ise scripts/db.mjs sağlayıcıyı kendisi "postgresql" yapar; bu satırı elle değiştirmeyin.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Yönetim paneli (backofis) hesabı — müşteri hesaplarından tamamen ayrıdır.
model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// Platform kullanıcısı (kiracı). Her kullanıcının kendi mağazaları ve verisi vardır.
model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  lastSyncAt   DateTime?
  // Paket (ödeme entegrasyonu yok; backofisten yönetilir)
  plan          String    @default("baslangic") // baslangic | profesyonel | kurumsal
  billingPeriod String    @default("aylik") // aylik | yillik
  trialEndsAt   DateTime?
  paidUntil     DateTime?
  suspended     Boolean   @default(false)
  billing       BillingInfo?
  payments      Payment[]
  // Stok ayarları
  safetyStock       Float  @default(0) // mağazalara yazılmayan tampon adet
  lowStockThreshold Float? // null = uyarı kapalı
  // Akıllı dağıtım: satılabilir stok bu değere ve altına inince yalnızca öncelikli mağazada satışa açılır.
  criticalStock     Float? // null = kapalı
  priorityStoreId   String? // kritik stokta satışa açık kalan mağaza
  notifications     Notification[]
  automationRules   AutomationRule[]
  websites          Website[]
  adIntegrations    AdIntegration[]
  costHistory       ProductCostHistory[]
  finTransactions   FinancialTransaction[]
  settlements       MarketplaceSettlement[]
  returnFinancials  ReturnFinancial[]
  expenses          Expense[]
  skuSettings    SkuSetting[]
  definitions    Definition[]
  stockMovements StockMovement[]
  stores       Store[]
  sharedItems  SharedItem[]
  syncLogs     SyncLog[]
}

model Store {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  label           String // panelde görünen ad
  platform        String         @default("ikas") // yalnızca "ikas" desteklenir
  storeName       String // <storeName>.myikas.com
  externalId      String? // kullanılmıyor (eski kayıtlarla uyum için tutuluyor)
  clientId        String
  clientSecretEnc String // AES-256-GCM ile şifreli
  accessToken     String?
  tokenExpiresAt  DateTime?
  stockLocationId String?
  webhookSecret   String
  webhooksActive  Boolean        @default(false)
  lastOrderSyncAt DateTime?
  lastCartSyncAt  DateTime?
  lastSyncAt      DateTime?
  lastError       String?
  merchantId      String? // görsel adresleri için
  // Otomatik fiyat kuralı: bu mağazanın fiyatı = diğer mağazanın fiyatı × (1 + yüzde/100) + sabit
  priceRuleActive Boolean        @default(false)
  pricePercent    Float          @default(0)
  priceFixed      Float          @default(0)
  priceRound      String         @default("none") // none | 1 | 0.90 | 0.99
  stockSharePercent Float        @default(100) // ortak stoğun bu mağazada görünen payı
  minStock        Float          @default(0) // stok varsa bu mağazaya en az bu kadar yazılır (kritik mod hariç)
  createdAt       DateTime       @default(now())
  variants        StoreVariant[]
  aliases         SkuAlias[]
  orders          Order[]
  costHistory     ProductCostHistory[]
  finTransactions FinancialTransaction[]
  website         Website?
  carts           AbandonedCart[]
  sfKey           String?        @unique // vitrin betiğinin herkese açık anahtarı (gizli değildir, yenilenebilir)
  sfModules       StoreModule[]
  sfStats         ModuleStat[]
  wheelEntries    WheelEntry[]
  productMetas    ProductMeta[]

  @@unique([userId, storeName])
}

// SKU başına ortak (paylaşılan) stok — tek doğru kaynak.
model SharedItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sku         String
  name        String
  sharedStock Float
  // Panelden yapılan, bir sonraki senkronda uygulanacak düzeltme
  pendingDelta Float   @default(0)
  pendingNote  String?
  updatedAt   DateTime @updatedAt

  @@unique([userId, sku])
}

// Fatura bilgileri (hesap başına bir kayıt)
model BillingInfo {
  id        String @id @default(cuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String @default("kurumsal") // bireysel | kurumsal
  name      String // ad soyad veya şirket unvanı
  taxNumber String // TCKN veya VKN
  taxOffice String @default("")
  address   String
  district  String
  city      String
  phone     String
  email     String
}

// Lisans siparişi / ödeme kaydı
model Payment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reference   String    @unique // havale açıklamasına yazılan kod
  plan        String
  period      String // aylik | yillik
  amount      Float // KDV hariç
  vat         Float
  total       Float
  method      String    @default("havale") // havale | kart
  status      String    @default("bekliyor") // bekliyor | bildirildi | odendi | iptal
  billingJson String // sipariş anındaki fatura bilgileri
  createdAt   DateTime  @default(now())
  paidAt      DateTime?
  periodEnd   DateTime?

  @@index([userId, createdAt])
  @@index([status])
}

// SKU'ya özel ayarlar
model SkuSetting {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sku               String
  excluded          Boolean @default(false) // ortak stok senkronu dışında
  safetyStock       Float? // null = genel ayar
  lowStockThreshold Float? // null = genel ayar
  // Tanımlamalar (Definition) içinden atananlar; ad olarak saklanır.
  category          String?
  brand             String?
  fields            String  @default("{}") // özel alan değerleri: { "alan adı": "değer" }

  @@unique([userId, sku])
  @@index([userId, category])
  @@index([userId, brand])
}

// Tanımlamalar: kullanıcının kendi kategori, marka ve özel alan adları (platformdan bağımsız).
model Definition {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // category | brand | field
  name      String
  createdAt DateTime @default(now())

  @@unique([userId, kind, name])
}

// Ortak stok hareketleri
model StockMovement {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sku         String
  createdAt   DateTime @default(now())
  storeLabel  String?
  delta       Float
  sharedAfter Float
  reason      String // sale | increase | panel | link
  note        String?

  @@index([userId, sku, createdAt])
}

// Bir mağazadaki varyant ve o mağazada en son gördüğümüz/yazdığımız stok.
model StoreVariant {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sku           String
  productId     String
  variantId     String
  productName   String
  currentStock  Float    @default(0)
  sellPrice     Float?
  discountPrice Float?
  buyPrice      Float?
  imageId       String?
  barcode       String?
  // Mağazalar arası eşleşme anahtarı: normalde SKU, elle eşleştirme varsa karşı mağazanın SKU'su
  matchSku      String   @default("")
  lastSeenStock Float? // null = henüz ortak stoğa bağlanmadı
  duplicateSku  Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  @@unique([storeId, variantId])
  @@index([storeId, sku])
  @@index([storeId, matchSku])
}

// Elle SKU eşleştirme: bu mağazadaki "sku", ortak stokta "matchSku" olarak sayılır.
model SkuAlias {
  id       String @id @default(cuid())
  storeId  String
  store    Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sku      String
  matchSku String

  @@unique([storeId, sku])
}

// Sipariş — müşteri adı, e-posta, telefon, adres gibi alanlar BİLEREK yok.
model Order {
  id              String      @id @default(cuid())
  storeId         String
  store           Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ikasOrderId     String
  orderNumber     String
  status          String
  paymentStatus   String?
  packageStatus   String?
  currency        String
  totalFinalPrice Float
  orderedAt       DateTime?
  shippingMethod  String?
  // Kargo paketleri (JSON): [{ number, barcode, cargoCompany, trackingNumber, trackingLink }]
  packages        String      @default("[]")
  // Rapor alanları (kişisel veri içermez: yalnızca kanal, kaynak, il/ilçe, kampanya)
  salesChannel    String?
  trafficSource   String?
  referer         String? // yalnızca alan adı
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  city            String?
  district        String?
  couponCode      String?
  campaigns       String      @default("[]") // [{ name, type, amount }]
  tags            String      @default("[]") // otomasyonun eklediği etiketler
  // Panelden silindi (ikas'ta durur). Senkron tekrar getirse de gizli kalır.
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  lines           OrderLine[]
  // Finansal alanlar (ikas belgesiyle doğrulanmış; null = bu sipariş için alınamadı)
  totalPrice      Float? // ikas totalPrice: kalemlerin net fiyat toplamı
  shippingTotal   Float? // shippingLines[].finalPrice toplamı (müşteriden alınan kargo ücreti; kargo GİDERİ değildir)
  shippingTax     Float? // shippingLines[].taxValue toplamı
  taxTotal        Float? // taxLines[].price toplamı (kalem + kargo + hediye paketi)
  finSyncedAt     DateTime?
  transactions    FinancialTransaction[]
  returns         ReturnFinancial[]

  @@unique([storeId, ikasOrderId])
  @@index([storeId, orderedAt])
}

model OrderLine {
  id         String @id @default(cuid())
  orderId    String
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku        String
  name       String
  quantity   Float
  finalPrice Float?
  imageId    String?
  ikasLineId String?
  status     String?
  // Maliyet snapshot'ı: sipariş anında geçerli birim maliyet (ProductCostHistory). Bilinmiyorsa null (eksik); sonradan değişmez.
  listPrice      Float? // ikas price: indirim öncesi birim satış fiyatı
  taxAmount      Float? // ikas taxValue: kalemin KDV tutarı (fiyatın KDV dahil olup olmadığı belgede belirtilmiyor)
  unitCost       Float?
  costCurrency   String?
  costSource     String? // IKAS_BUY_PRICE | MANUAL | DEMO
  costCapturedAt DateTime?
}

// Terk edilmiş sepet — müşteri adı, e-posta, telefon alınmaz.
model AbandonedCart {
  id             String    @id @default(cuid())
  storeId        String
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ikasId         String
  status         String // OPEN | COMPLETED | FREEZE | KILLED
  recoveryStatus String? // NOT_RECOVERED | RECOVERED
  emailStatus    String? // NOT_SENT | SENT
  total          Float
  currency       String    @default("TRY")
  itemCount      Float     @default(0)
  couponCode     String?
  city           String?
  lastActivityAt DateTime?
  linesJson      String    @default("[]") // [{ name, sku, imageId, quantity, price }]
  seenAt         DateTime  @default(now())

  @@unique([storeId, ikasId])
  @@index([storeId, lastActivityAt])
}

model SyncLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  level     String   @default("info") // info | warn | error
  sku       String?
  storeLabel String?
  message   String

  @@index([userId, createdAt])
}

// Panel bildirimleri (kritik stok, otomasyon). Okununca readAt dolar.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // stock | automation
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

// Sipariş otomasyonu: koşullar (VE) sağlanınca aksiyonlar çalışır.
model AutomationRule {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  active     Boolean         @default(true)
  conditions String          @default("[]") // [{ field, op, value }]
  actions    String          @default("[]") // [{ type, value }]
  runCount   Int             @default(0)
  lastRunAt  DateTime?
  createdAt  DateTime        @default(now())
  runs       AutomationRun[]

  @@index([userId, active])
}

// Bir kural bir siparişte yalnızca bir kez çalışır (tekrarlı webhook/senkron güvenliği).
model AutomationRun {
  id        String         @id @default(cuid())
  ruleId    String
  rule      AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  orderId   String
  createdAt DateTime       @default(now())

  @@unique([ruleId, orderId])
}

// ───────────── Reklam analizi ─────────────
// Kullanıcının web sitesi. Bir siteye en fazla bir ikas mağazası bağlanır; bir mağaza tek siteye aittir.
model Website {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  domain     String // küçük harf, protokolsüz, www'suz (ör. magazam.com)
  storeId    String?            @unique
  store      Store?             @relation(fields: [storeId], references: [id], onDelete: SetNull)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  adAccounts WebsiteAdAccount[]
  analytics  AnalyticsProperty?

  @@unique([userId, domain])
}

// Bir reklam platformu bağlantısı (OAuth). Token'lar AES-256-GCM ile şifreli saklanır.
model AdIntegration {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String // meta | google | ga4
  externalUserId  String // platformdaki kullanıcı/yetkilendiren kimliği
  displayName     String?
  accessTokenEnc  String
  refreshTokenEnc String?
  tokenExpiresAt  DateTime?
  scopes          String      @default("")
  status          String      @default("active") // active | expired | revoked | error
  lastError       String?
  lastSyncAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  accounts        AdAccount[]
  properties      AnalyticsProperty[]

  @@unique([userId, provider, externalUserId])
}

// Bağlantı üzerinden erişilen reklam hesabı (Meta act_..., Google müşteri kimliği).
model AdAccount {
  id            String             @id @default(cuid())
  integrationId String
  integration   AdIntegration      @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  provider      String // meta | google (sorgu kolaylığı için tekrarlanır)
  externalId    String
  name          String
  currency      String?
  timezone      String?
  managerId     String? // Google MCC altındaysa yönetici hesap kimliği
  remoteStatus  Int? // platformdaki hesap durumu (Meta account_status)
  metricsSyncedAt DateTime? // reklam verisinin son çekildiği an (gereksiz API çağrısını önlemek için)
  metricsError  String?
  metricsFrom   String? // senkronun kapsadığı en eski gün (YYYY-MM-DD); öncesi "veri yok"
  levelSyncedAt DateTime? // reklam seti / reklam düzeyi son senkron
  levelError    String?
  productSyncedAt DateTime? // ürün düzeyi reklam senkronu (shopping_performance_view / Meta product_id kırılımı)
  productError    String?
  productDaily    AdProductDaily[]
  campaigns     AdCampaign[]
  adSets        AdSet[]
  ads           Ad[]
  levelDaily    AdLevelDaily[]
  reachPeriods  AdReachPeriod[]
  metrics       AdDailyMetric[]
  selected      Boolean            @default(false) // kullanıcı raporlamaya dahil etti mi
  createdAt     DateTime           @default(now())
  websites      WebsiteAdAccount[]

  @@unique([integrationId, externalId])
}

// Site ↔ reklam hesabı (çoka çok). İkisi de aynı kullanıcıya ait olmalı; uygulama katmanında denetlenir.
model WebsiteAdAccount {
  websiteId   String
  website     Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  adAccountId String
  adAccount   AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([websiteId, adAccountId])
}

// Reklam kampanyası (Meta campaign / Google campaign).
model AdCampaign {
  id          String          @id @default(cuid())
  adAccountId String
  adAccount   AdAccount       @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  externalId  String
  name        String
  status      String? // Meta effective_status
  objective   String?
  // Bütçe (hesap para biriminde). Meta: kampanya bütçesi (CBO) yoksa bütçe reklam seti düzeyindedir. Google: campaign_budget.
  dailyBudget    Float?
  lifetimeBudget Float?
  budgetLevel    String? // campaign | adset | null (bilinmiyor)
  updatedAt   DateTime        @updatedAt
  metrics     AdDailyMetric[]
  productDaily AdProductDaily[]
  adSets      AdSet[]
  ads         Ad[]

  @@unique([adAccountId, externalId])
}

// Kampanya başına günlük ham metrikler. Oranlar (CPC, CPM, CTR, ROAS) saklanmaz; toplamlardan hesaplanır.
// Tarih, reklam hesabının saat dilimindeki gündür (Meta verisi hesabın saat diliminde raporlanır).
model AdDailyMetric {
  id            String     @id @default(cuid())
  adAccountId   String
  adAccount     AdAccount  @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  campaignId    String
  campaign      AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  date          String // YYYY-MM-DD
  currency      String?
  spend         Float      @default(0)
  impressions   Int        @default(0)
  reach         Int        @default(0) // günlük erişim; günler arasında toplanamaz
  clicks        Int        @default(0)
  purchases     Float      @default(0) // platformun raporladığı satın alma
  purchaseValue Float      @default(0) // platformun raporladığı dönüşüm değeri
  // Meta huni eylemleri (null = çekilmedi / desteklenmiyor; 0 = gerçekten sıfır). Google için doldurulmaz.
  linkClicks       Int?   // Meta inline_link_clicks
  landingPageViews Float? // landing_page_view
  viewContent      Float? // omni_view_content | offsite_conversion.fb_pixel_view_content
  addToCart        Float? // omni_add_to_cart | offsite_conversion.fb_pixel_add_to_cart
  initiateCheckout Float? // omni_initiated_checkout | offsite_conversion.fb_pixel_initiate_checkout
  updatedAt     DateTime   @updatedAt

  @@unique([campaignId, date])
  @@index([adAccountId, date])
}

// Google Analytics 4 mülkü. Bir siteye en fazla bir mülk bağlanır.
model AnalyticsProperty {
  id              String           @id @default(cuid())
  integrationId   String
  integration     AdIntegration    @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  propertyId      String // yalnızca rakam (properties/123 → 123)
  name            String
  accountName     String?
  currency        String?
  timezone        String?
  websiteId       String?          @unique
  website         Website?         @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  metricsSyncedAt DateTime?
  metricsError    String?
  createdAt       DateTime         @default(now())
  daily           AnalyticsDaily[]
  campaignDaily   AnalyticsCampaignDaily[]

  @@unique([integrationId, propertyId])
}

// GA4 günlük metrikleri, varsayılan kanal grubuna göre. Kullanıcı sayısı günler ve kanallar arasında toplanamaz.
model AnalyticsDaily {
  id         String            @id @default(cuid())
  propertyId String
  property   AnalyticsProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  date       String // YYYY-MM-DD, mülkün saat diliminde
  channel    String // sessionDefaultChannelGroup
  sessions   Int               @default(0)
  users      Int               @default(0)
  keyEvents  Float             @default(0)
  purchases  Float             @default(0) // ecommercePurchases
  revenue    Float             @default(0) // purchaseRevenue
  updatedAt  DateTime          @updatedAt

  @@unique([propertyId, date, channel])
}

// Vitrin modülü: ikas mağazasının canlı temasında çalışan bir modülün mağazaya özel ayarı.
model StoreModule {
  id          String    @id @default(cuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  moduleKey   String // src/lib/storefront/modules.ts içindeki anahtar
  enabled     Boolean   @default(false)
  settings    String    @default("{}") // yayındaki ayarlar (JSON)
  draft       String? // yayınlanmamış taslak (JSON); yalnızca önizlemede görünür
  version     Int       @default(0)
  publishedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([storeId, moduleKey])
}

// Vitrin modülü olayları, gün bazında toplanır (ziyaretçi kimliği saklanmaz).
model ModuleStat {
  id        String @id @default(cuid())
  storeId   String
  store     Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  moduleKey String
  day       String // YYYY-MM-DD (UTC)
  type      String // view | click | use | convert
  count     Int    @default(0)
  value     Float  @default(0) // dönüşüm tutarı toplamı
  @@unique([storeId, moduleKey, day, type])
}

// Hediye Çarkı katılımı. KVKK: iletişim bilgisi ve IP düz metin saklanmaz; tekrar kontrolü için anahtarlı özet (HMAC) tutulur.
// İletişim bilgisi yalnızca mağaza "sakla" seçeneğini açtıysa ve ziyaretçi açık rıza verdiyse şifreli (AES-256-GCM) saklanır.
model WheelEntry {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  contactHash String? // e-posta/telefon HMAC
  contactEnc  String? // yalnızca rıza ile, şifreli
  consent     Boolean  @default(false)
  ipHash      String
  cookieId    String
  prizeKey    String // dilim kimliği (ayar içindeki sıra değil, kalıcı anahtar)
  prizeLabel  String
  prizeType   String // RATIO | FIXED_AMOUNT | FREE_SHIPPING | CODE | NONE
  code        String?  @unique // kişiye özel ikas kuponu
  campaignId  String? // ikas kampanya kimliği
  createdAt   DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([storeId, contactHash])
  @@index([storeId, ipHash])
  @@index([storeId, cookieId])
}

// Vitrin modülleri için ikas ürün bilgisi (Admin API listProduct): vitrin bağlantısı, kategoriler ve eklenme tarihi.
// Ortak stok senkronundan bağımsızdır; modüller yayınlanınca ve en fazla 6 saatte bir yenilenir.
model ProductMeta {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId   String
  name        String
  slug        String
  categoryIds String   @default("[]") // JSON
  createdAt   DateTime? // ikas ürün oluşturma zamanı
  syncedAt    DateTime @default(now())

  @@unique([storeId, productId])
  @@index([storeId, slug])
}

// Meta reklam seti / Google reklam grubu. Platformun kendi kimliğiyle tekil (hesap içinde).
model AdSet {
  id             String     @id @default(cuid())
  adAccountId    String
  adAccount      AdAccount  @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  campaignId     String
  campaign       AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  externalId     String
  kind           String // adset (Meta) | ad_group (Google)
  name           String
  status         String?
  dailyBudget    Float? // yalnızca Meta reklam seti bütçesi (ABO)
  lifetimeBudget Float?
  optimization   String? // Meta optimization_goal
  updatedAt      DateTime   @updatedAt
  ads            Ad[]
  daily          AdLevelDaily[]

  @@unique([adAccountId, externalId])
  @@index([campaignId])
}

// Reklam (Meta ad / Google ad_group_ad.ad).
model Ad {
  id          String     @id @default(cuid())
  adAccountId String
  adAccount   AdAccount  @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  campaignId  String
  campaign    AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adSetId     String
  adSet       AdSet      @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  externalId  String
  name        String
  status      String?
  adType      String? // Google ad_group_ad.ad.type
  // Kreatif bilgisi (her senkronda yeniden okunur; görsel adresleri süreli olabilir).
  creativeId      String? // Meta AdCreative kimliği
  creativeType    String? // IMAGE | VIDEO | CAROUSEL | DYNAMIC | TEXT | DISPLAY | OTHER
  objectType      String? // Meta object_type (ham değer)
  thumbnailUrl    String? // Meta thumbnail_url ya da Google ilk görsel asset adresi
  imageUrl        String? // Meta image_url
  videoId         String? // Meta video_id ya da Google YouTube video kimliği
  assets          String? // Google asset listesi (JSON): [{ fieldType, label, type, url, videoId, text }]
  creativeSyncedAt DateTime?
  updatedAt   DateTime   @updatedAt
  daily       AdLevelDaily[]

  @@unique([adAccountId, externalId])
  @@index([adSetId])
  @@index([campaignId])
}

// Reklam seti ve reklam düzeyi günlük metrikler. Kampanya düzeyi (AdDailyMetric) ile karıştırılmaz.
// Erişim burada tutulmaz (günler arasında toplanamaz); dönem erişimi AdReachPeriod'dadır.
model AdLevelDaily {
  id            String    @id @default(cuid())
  adAccountId   String
  adAccount     AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  level         String // adset | ad
  entityId      String // AdSet.id ya da Ad.id
  adSetId       String?
  adSet         AdSet?    @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  adId          String?
  ad            Ad?       @relation(fields: [adId], references: [id], onDelete: Cascade)
  date          String // YYYY-MM-DD (hesap saat dilimi)
  spend         Float     @default(0)
  impressions   Int       @default(0)
  clicks        Int       @default(0)
  purchases     Float     @default(0)
  purchaseValue Float     @default(0)
  updatedAt     DateTime  @updatedAt

  @@unique([level, entityId, date])
  @@index([adAccountId, date])
}

// Dönem bazlı (tekilleştirilmiş) erişim ve frekans. Yalnızca Meta; tek dönem sorgusuyla alınır, 6 saat önbellek.
model AdReachPeriod {
  id          String    @id @default(cuid())
  adAccountId String
  adAccount   AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  level       String // campaign | adset | ad
  entityId    String // AdCampaign.id / AdSet.id / Ad.id
  fromDate    String
  toDate      String
  reach       Int?
  frequency   Float?
  fetchedAt   DateTime  @default(now())

  @@unique([level, entityId, fromDate, toDate])
  @@index([adAccountId])
}

// GA4 kampanya/kaynak kırılımlı e-ticaret hunisi (Data API runReport). Kanal bazlı AnalyticsDaily'den ayrıdır.
model AnalyticsCampaignDaily {
  id               String            @id @default(cuid())
  propertyId       String
  property         AnalyticsProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  date             String // YYYY-MM-DD (mülk saat dilimi)
  source           String // sessionSource
  medium           String // sessionMedium
  campaign         String // sessionCampaignName
  googleAdsCampaign String // sessionGoogleAdsCampaignName ("(not set)" = Google Ads dışı)
  sessions         Int               @default(0)
  itemViews        Float             @default(0) // itemViewEvents
  addToCarts       Float             @default(0)
  checkouts        Float             @default(0)
  purchases        Float             @default(0) // ecommercePurchases
  revenue          Float             @default(0) // purchaseRevenue
  updatedAt        DateTime          @updatedAt

  @@unique([propertyId, date, source, medium, campaign, googleAdsCampaign])
  @@index([propertyId, date])
}

// Ürün düzeyi reklam metrikleri (platformun kendi ürün kırılımı; tahmini dağıtım YOK).
// Google: FROM shopping_performance_view (segments.product_item_id = Merchant Center teklif kimliği, product_title).
// Meta: insights breakdowns=product_id. Meta, site dışı (piksel) dönüşümlerde ürün kırılım değerini döndürmez:
// bu yüzden Meta satırlarında conversions/conversionValue null'dır (desteklenmiyor), 0 değildir.
model AdProductDaily {
  id              String     @id @default(cuid())
  adAccountId     String
  adAccount       AdAccount  @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  campaignId      String
  campaign        AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  date            String
  productKey      String // platformun döndürdüğü ham ürün kimliği
  productTitle    String?
  spend           Float?
  impressions     Int        @default(0)
  clicks          Int        @default(0)
  conversions     Float?
  conversionValue Float?
  updatedAt       DateTime   @updatedAt

  @@unique([campaignId, date, productKey])
  @@index([adAccountId, date])
}

// Ürün maliyet geçmişi (mağaza + SKU). Bir dönemin maliyeti değişince yeni kayıt açılır, eskisi validTo ile kapanır.
// Geçmişe dönük maliyet yalnızca kullanıcı elle girerse (MANUAL) oluşur; güncel maliyet geçmişe uygulanmaz.
model ProductCostHistory {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sku        String
  productId  String?
  unitCost   Float // toplam birim maliyet (alış + üretim + paketleme + etiket + diğer)
  purchaseCost  Float? // bileşenler (girilmişse; toplamı unitCost'a eşittir)
  productionCost Float?
  packagingCost  Float?
  labelCost      Float?
  otherCost      Float?
  currency   String? // bilinmiyorsa null: farklı para birimindeki satışa uygulanmaz
  validFrom  DateTime
  validTo    DateTime? // null = hâlâ geçerli
  source     String // IKAS_BUY_PRICE | MANUAL | DEMO
  note       String?
  createdAt  DateTime  @default(now())

  @@index([storeId, sku, validFrom])
  @@index([userId])
}

// Ortak finansal kayıt: tüm satış kanallarından gelen gider/gelir hareketleri normalize edilerek burada tutulur.
// Aynı dış kayıt tekrar aktarılınca (userId, source, externalId) tekilliği sayesinde güncellenir, mükerrer oluşmaz.
// Tutar her zaman pozitiftir; yön "direction" ile belirtilir (DEBIT = işletmeden çıkan, CREDIT = işletmeye giren).
model FinancialTransaction {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId      String?
  store        Store?    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId      String?
  order        Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  settlementId String?
  settlement   MarketplaceSettlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  source       String // IKAS | TRENDYOL | HEPSIBURADA | AMAZON | N11 | MANUAL | DEMO
  externalId   String
  type         String // MARKETPLACE_COMMISSION | PAYMENT_FEE | SHIPPING_COST | SHIPPING_INCOME | PACKAGING | SERVICE_FEE | RETURN_SHIPPING | OTHER
  direction    String // DEBIT | CREDIT
  amount       Float // brüt (vergi dahilse vergi dahil) tutar, pozitif
  currency     String
  taxAmount    Float? // bilinmiyorsa null
  taxRate      Float?
  taxInclusive Boolean? // amount vergi dahil mi; bilinmiyorsa null
  fxRate       Float? // dönüşüm yapıldıysa kullanılan kur
  fxCurrency   String?
  fxDate       DateTime?
  occurredAt   DateTime
  status       String    @default("POSTED") // POSTED | PENDING | CANCELLED
  note         String?
  // Ürünlere dağıtım yöntemi: REVENUE (satış tutarı, varsayılan) | QUANTITY (adet) | WEIGHT (ağırlık) | MANUAL (CostAllocation satırları)
  allocationMethod String?
  allocations  CostAllocation[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, source, externalId])
  @@index([userId, occurredAt])
  @@index([orderId])
}

// Pazaryeri hakediş özeti (ödeme dönemi). Ayrıntı kesintiler FinancialTransaction olarak bağlanır.
model MarketplaceSettlement {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId          String?
  source           String
  externalId       String // pazaryeri işlem / hakediş numarası
  currency         String
  grossSales       Float?
  commission       Float?
  shippingDeduction Float?
  serviceFee       Float?
  returnDeduction  Float?
  otherDeduction   Float?
  netPayout        Float?
  payoutDate       DateTime?
  status           String    @default("POSTED")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  transactions     FinancialTransaction[]

  @@unique([userId, source, externalId])
}

// İade / geri ödemenin finansal etkisi. Aynı iade iki kez sayılmaz: (userId, source, externalId) tekil.
// Bir siparişte iade kaydı varsa net satıştan bu kayıtların tutarı düşülür; kalem durumundan türetilen iade o sipariş için kullanılmaz.
model ReturnFinancial {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId          String?
  orderId          String?
  order            Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  source           String
  externalId       String
  amount           Float // müşteriye geri ödenen tutar (pozitif)
  currency         String
  taxAmount        Float?
  includesShipping Boolean?
  reason           String?
  refundedAt       DateTime
  status           String    @default("POSTED")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, source, externalId])
  @@index([orderId])
}

// Elle gider dağıtımı: bir sipariş giderinin hangi ürüne (SKU) ne kadar yazılacağı. Toplam, giderin tutarını aşamaz; kalan "dağıtılamayan" görünür.
model CostAllocation {
  id            String               @id @default(cuid())
  transactionId String
  transaction   FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  sku           String
  amount        Float

  @@unique([transactionId, sku])
}

// İşletme gideri (siparişe bağlı olmayan): personel, kira, yazılım, depolama, diğer. Bir dönemi kapsar; rapor dönemine gün bazında paylaştırılır.
// Reklam platformlarından senkronlanan harcamalar buraya GİRİLMEZ (çift sayım olur); ADVERTISING yalnızca platform dışı reklam giderleri içindir.
model Expense {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId      String?
  category     String // PERSONNEL | RENT | SOFTWARE | STORAGE | ADVERTISING | OTHER
  amount       Float
  currency     String
  taxAmount    Float?
  taxRate      Float?
  taxInclusive Boolean?
  periodStart  DateTime
  periodEnd    DateTime // dahil
  source       String   @default("MANUAL") // MANUAL | DEMO
  status       String   @default("POSTED") // POSTED | CANCELLED
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, periodStart])
}
